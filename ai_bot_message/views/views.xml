<odoo>
    <record id="view_order_form_inherit_bot" model="ir.ui.view">
        <field name="name">purchase.order.form.ai.bot</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_odoo_bot_message"
                        string="OdooBot 发消息"
                        type="object"
                        class="oe_highlight"/>
            </xpath>
        </field>
    </record>
</odoo>
